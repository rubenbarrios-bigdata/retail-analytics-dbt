              "solid": {
                "color": "#1E293B"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "showTitle": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 22,
            "fontFamily": "Segoe UI Bold",
            "labelDisplayUnits": 1
          }
        ],
        "categoryLabels": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
