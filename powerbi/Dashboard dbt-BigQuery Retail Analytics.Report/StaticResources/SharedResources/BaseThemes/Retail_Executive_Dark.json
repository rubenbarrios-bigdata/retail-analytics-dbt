            "shadowSpread": 1,
            "shadowBlur": 8,
            "angle": 45,
            "shadowDistance": 3,
            "transparency": 65
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
