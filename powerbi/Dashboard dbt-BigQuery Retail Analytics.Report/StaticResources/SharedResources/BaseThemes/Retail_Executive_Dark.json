            "backColorPrimary": {
              "solid": {
                "color": "#111827"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#172033"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    }
