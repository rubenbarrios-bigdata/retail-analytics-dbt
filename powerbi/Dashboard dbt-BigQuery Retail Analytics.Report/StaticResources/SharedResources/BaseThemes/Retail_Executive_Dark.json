{
  "name": "Retail_Executive_Dark",
  "dataColors": [
    "#38BDF8",
    "#10B981",
    "#F59E0B",
    "#818CF8",
    "#F43F5E",
    "#A78BFA",
    "#34D399",
    "#FB923C",
    "#22D3EE",
    "#EC4899"
  ],
  "background": "#0B0F19",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B0F19"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#070A12"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111827"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
