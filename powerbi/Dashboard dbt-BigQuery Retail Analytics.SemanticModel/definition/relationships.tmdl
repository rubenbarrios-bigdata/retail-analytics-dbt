relationship rel_fct_orders_Calendario
	fromColumn: fct_orders.order_date
	toColumn: Calendario.Fecha

relationship rel_fct_orders_dim_customers
	fromColumn: fct_orders.customer_id
	toColumn: dim_customers.customer_id

relationship rel_fct_orders_Canales
	fromColumn: fct_orders.channel
	toColumn: Canales.channel

relationship rel_fct_orders_Estados
	fromColumn: fct_orders.status
	toColumn: Estados.status

relationship rel_stg_order_items_fct_orders
	fromColumn: stg_order_items.order_id
	toColumn: fct_orders.order_id

relationship rel_stg_order_items_dim_products
	fromColumn: stg_order_items.product_id
	toColumn: dim_products.product_id

