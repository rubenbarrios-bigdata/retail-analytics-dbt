		dataType: int64
		formatString: 0
		lineageTag: 7dbb1eea-a19d-472d-ae7c-3f8247203cfb
		summarizeBy: sum
		sourceColumn: total_items_count

		annotation SummarizationSetBy = Automatic

	column total_units_count
		dataType: int64
