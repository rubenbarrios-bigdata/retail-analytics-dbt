		annotation SummarizationSetBy = Automatic

	column status
		dataType: string
		lineageTag: 80c5e7d1-ea98-4b11-9ced-5d4456d5d241
		summarizeBy: none
		sourceColumn: status

		annotation SummarizationSetBy = Automatic

