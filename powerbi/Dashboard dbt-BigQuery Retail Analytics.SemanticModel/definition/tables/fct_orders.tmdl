		dataType: double
		lineageTag: 2d8aaeac-7894-40a6-a7ca-c847c3e004eb
		summarizeBy: sum
		sourceColumn: net_amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column is_completed_order
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1e97adea-0d14-4ccd-b2e8-b549b37c2c6a
		summarizeBy: none
		sourceColumn: is_completed_order

		annotation SummarizationSetBy = Automatic

	partition fct_orders = m
		mode: import
		source =
				let
				  Origen = GoogleBigQuery.Database([BillingProject = null, UseStorageApi = null, ConnectionTimeout = null, CommandTimeout = null]),
				  #"Navegación 1" = Origen{[Name = "dbt-retail-analytics"]}[Data],
				  #"Navegación 2" = #"Navegación 1"{[Name = "dbt_dev", Kind = "Schema"]}[Data],
				  #"Navegación 3" = #"Navegación 2"{[Name = "fct_orders", Kind = "Table"]}[Data]
				in
				  #"Navegación 3"

