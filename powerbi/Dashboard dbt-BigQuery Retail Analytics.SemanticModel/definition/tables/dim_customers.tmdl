	/// Orden jerárquico del segmento de cliente (VIP a Prospect).
	column 'Orden Segmento' = VAR _Gasto = CALCULATE([Venta Neta]) VAR _Pedidos = CALCULATE([Pedidos Efectivos]) RETURN IF(_Gasto >= 600, 1, IF(_Pedidos >= 3, 2, 3))
		isHidden
		formatString: 0
		lineageTag: 0cbd09af-b018-4e76-8c7e-16380d52ce98

	/// Segmento de cliente en español (VIP, Frecuente, Activo, Prospecto).
	column Segmento = VAR _Gasto = CALCULATE([Venta Neta]) VAR _Pedidos = CALCULATE([Pedidos Efectivos]) RETURN IF(_Gasto >= 600, "VIP", IF(_Pedidos >= 3, "Frecuente", "Activo"))
		lineageTag: ab280751-65c8-4b7d-80a1-7f7d486a5ee8
		sortByColumn: 'Orden Segmento'

	/// País del cliente en español.
	column País = SWITCH(dim_customers[country], "Spain", "España", "Brazil", "Brasil", "Mexico", "México", "Peru", "Perú", dim_customers[country])
		lineageTag: 09fa0937-a00f-4ce9-8822-406fb5a32490
		dataCategory: Country

